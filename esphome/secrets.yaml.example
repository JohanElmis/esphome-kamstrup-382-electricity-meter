# Copy to secrets.yaml and fill in. secrets.yaml is git-ignored.
# All 5 nodes share this file (same WiFi/broker); per-node identity comes from
# the node yaml, not from here.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"
ap_password: "fallback-hotspot-password"

# Home Assistant native API encryption key.
# Generate one with:  openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# OTA update password.
ota_password: "your-ota-password"

# MQTT broker.
mqtt_broker: "192.168.1.10"
mqtt_username: "kamstrup"
mqtt_password: "your-mqtt-password"
